# Copy to .env and fill in. .env is git-ignored.

# Which backend Squeeze calls: meta-api | openai-compat | mock
SQUEEZE_BACKEND=meta-api

# Meta Model API (https://dev.meta.ai/)
META_API_KEY=
# Base URL and model ID: confirm both in Meta's quickstart before the first run.
META_BASE_URL=
META_MODEL=muse-spark

# Muse Spark Open on Baseten or Modal (any OpenAI-compatible endpoint)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=meta-models/muse-spark-open-1026
