# Copy to .env and fill in. Squeeze reads ./.env on start; .env is git-ignored.

# Which backend Squeeze calls: meta-api | openai-compat | mock
SQUEEZE_BACKEND=meta-api

# Meta Model API (https://dev.meta.ai/). Only the key is required.
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
# Avoid the "-contributor" model: it lets Meta train on your documents.
# META_MODEL=muse-spark-1.3

# Muse Spark Open on Baseten or Modal (any OpenAI-compatible endpoint)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=meta-models/muse-spark-open-1026
